# GEMINI_API_KEY: Required for Gemini AI API calls on the server.
# Never expose this key in client-side code or commit a real .env file.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# GEMINI_DEFAULT_MODEL: Default Gemini model supporting generateContent.
GEMINI_DEFAULT_MODEL="gemini-4-hydrogen"

# ADMIN_USERNAME / ADMIN_PASSWORD: Optional server-side admin overrides for /admin.
# Set these in production secrets instead of relying on defaults.
ADMIN_USERNAME=""
ADMIN_PASSWORD=""

# ALLOWED_ORIGINS: Comma-separated list of allowed CORS origins in production.
# Example: https://edugenius.example.com,https://app.edugenius.example.com
ALLOWED_ORIGINS="http://localhost:3000"

# APP_URL: The public URL where this application is hosted.
APP_URL="http://localhost:3000"

# PORT: Port for the Express + Vite server (default 3000).
PORT=3000
